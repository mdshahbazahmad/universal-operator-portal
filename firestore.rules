rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmailMatches(data) {
      return signedIn() && request.auth.token.email_verified == true &&
        data.email is string && data.email == request.auth.token.email;
    }
    function isOperator() {
      return signedIn() && exists(/databases/$(database)/documents/operators/$(request.auth.uid));
    }
    function ownsWorker(workerId) {
      return signedIn() && exists(/databases/$(database)/documents/workers/$(workerId)) &&
        get(/databases/$(database)/documents/workers/$(workerId)).data.operatorUid == request.auth.uid;
    }
    function isWorkerOwner(data, workerId) {
      return signedIn() && (request.auth.uid == workerId || data.uid == request.auth.uid || verifiedEmailMatches(data));
    }
    function unchangedOperatorOwnership() {
      return ((!('operatorUid' in resource.data) && !('operatorUid' in request.resource.data)) ||
        (('operatorUid' in resource.data) && ('operatorUid' in request.resource.data) && request.resource.data.operatorUid == resource.data.operatorUid));
    }
    match /operators/{operatorId} {
      allow read, create, update: if signedIn() && request.auth.uid == operatorId;
      allow delete: if false;
    }
    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    match /workers/{workerId} {
      // Operators create unclaimed invite records; a worker's own canonical record must use their Firebase UID.
      allow create: if signedIn() && !('aadhaarNumber' in request.resource.data) && (
        (request.resource.data.operatorUid == request.auth.uid && isOperator() && request.resource.data.uid == '') ||
        (request.resource.data.uid == request.auth.uid && (!('operatorUid' in request.resource.data) || request.resource.data.operatorUid == request.auth.uid && isOperator()))
      );
      // A uid/email constrained query can now resolve migrated records for the authenticated person.
      allow read: if signedIn() && (isWorkerOwner(resource.data, workerId) || resource.data.operatorUid == request.auth.uid);
      allow update: if signedIn() && !('aadhaarNumber' in request.resource.data) && (
        (isWorkerOwner(resource.data, workerId) && request.resource.data.uid == request.auth.uid && unchangedOperatorOwnership()) ||
        (resource.data.operatorUid == request.auth.uid && isOperator() && request.resource.data.operatorUid == resource.data.operatorUid) ||
        (resource.data.status == 'Pending Registration' && resource.data.inviteToken is string &&
          resource.data.inviteToken.size() >= 32 && request.resource.data.inviteToken == resource.data.inviteToken &&
          resource.data.uid == '' && request.resource.data.uid == request.auth.uid &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.operatorUid == resource.data.operatorUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid','email','name','phone','gender','qualification','experience','skills','address',
            'status','updatedAt','registeredAt','inviteToken'
          ]))
      );
      allow delete: if signedIn() && resource.data.operatorUid == request.auth.uid && isOperator();
      match /private/{privateDoc} {
        allow read: if signedIn() && (request.auth.uid == workerId || ownsWorker(workerId));
        allow create, update: if signedIn() && (request.auth.uid == workerId || ownsWorker(workerId)) && privateDoc == 'identity' && request.resource.data.keys().hasOnly(['aadhaarNumber','updatedAt']) && (!('aadhaarNumber' in request.resource.data) || request.resource.data.aadhaarNumber is string && request.resource.data.aadhaarNumber.size() == 12);
        allow delete: if false;
      }
      match /attendance/{day} {
        allow read: if signedIn() && (request.auth.uid == workerId || ownsWorker(workerId));
        allow create: if signedIn() && request.auth.uid == workerId && request.resource.data.keys().hasOnly(['date','punchIn','punchOut','timestamp','updatedAt']) && request.resource.data.date == day && request.resource.data.punchIn is string;
        allow update: if signedIn() && request.auth.uid == workerId && request.resource.data.date == resource.data.date && resource.data.punchOut == null && request.resource.data.punchOut is string && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['punchOut','updatedAt']);
        allow delete: if false;
      }
    }
    match /complaints/{complaintId} {
      allow create: if isOperator() && request.resource.data.operatorUid == request.auth.uid && request.resource.data.status == 'Pending' && request.resource.data.keys().hasOnly(['operatorUid','ticketNo','customerName','customerPhone','address','lat','lng','issue','status','assignedWorkerId','source','createdAt']);
      allow read: if signedIn() && (resource.data.operatorUid == request.auth.uid || resource.data.assignedWorkerId == request.auth.uid);
      allow update: if signedIn() && ((resource.data.operatorUid == request.auth.uid && isOperator() && request.resource.data.operatorUid == resource.data.operatorUid) || (resource.data.assignedWorkerId == request.auth.uid && request.resource.data.assignedWorkerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','actionTaken','resolvedAt']) && request.resource.data.status in ['Done','Solved','Resolved','Completed']));
      allow delete: if isOperator() && resource.data.operatorUid == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
